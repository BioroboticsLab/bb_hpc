# Configuration parameters for transfer_files.sh
# example use:  bash transfer_files.sh transfer_files_example_config.config

# Source and destination base paths.
# The source must be a LOCAL path.
# The destination may be local, or remote as "[user@]host:/path"
# (ssh key-based auth and rsync installed on the remote host are assumed).
source="/mnt/local/beesbook2026/"
destination="user@remote_computer:/mnt/share/beesbook2026/"

# Leave empty or use "*" to transfer all files, set to e.g. "mp4" to transfer only certain files
file_extension="*"

# List of directories to transfer (leave empty for auto-discovery to transfer all subdirectories under the source dir)
directories=(
  "20260622" "20260623" "20260624" "20260625" "20260626"
)

# Whether to verify and remove source files after successful transfer.
# Verification is an rsync dry run: the source files are only removed when rsync
# reports that nothing is left to transfer to the destination.
check_and_remove=true
